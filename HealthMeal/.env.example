# HealthMeal 환경변수 예시
# 1) 이 파일을 복사해 .env 로 저장 (cp .env.example .env)
# 2) 값을 채운다. .env 는 .gitignore 에 들어 있어 커밋되지 않는다 — 실제 키를 이 예시 파일에 넣지 말 것
# 3) 앱(bootRun)과 load-* 명령은 실행 폴더(HealthMeal/)의 .env 를 자동으로 읽는다
#    (collect·ai-review 는 운영체제 환경변수만 읽으므로 그때는 직접 설정)

# ---- 필수: 데이터베이스 (MySQL) ----
DB_URL=jdbc:mysql://localhost:3306/healthmeal?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&rewriteBatchedStatements=true&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=root
DB_PASSWORD=

# ---- 필수(운영)·권장(개발): 건강검진 수치 암호화 키 (32바이트 Base64) ----
# 만드는 법: openssl rand -base64 32
# 주석(#)으로 두면 application.properties 의 개발용 공개 키를 쓴다 (빈 값으로 두면 오류) (공개 저장소에 있는 키이므로 실제 데이터에는 쓰지 말 것)
# 한 번 정한 뒤 바꾸면 이미 저장한 검진 수치를 읽을 수 없다
# HEALTH_DATA_KEY=

# ---- 선택: 업로드 파일 저장 폴더 (기본 uploads/, 공개 폴더 밖) ----
UPLOAD_DIR=uploads

# ---- 선택: Gemini (검진표 사진 AI 판독, ai-review) ----
# 없으면 사진 판독 버튼 대신 직접 입력 안내가 나온다. 발급: https://aistudio.google.com/apikey (무료 등급, 결제 연결 불필요)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-4-hydrogen

# ---- 선택: 공공 API 원본을 다시 받을 때만 (collect). data/raw 에 원본이 이미 있어 보통 필요 없음 ----
# FOODSAFETY_API_KEY=
# DATA_GO_KR_API_KEY=
